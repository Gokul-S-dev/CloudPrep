# Public API Gateway base URL. Do not add a trailing slash.
VITE_API_BASE_URL=https://your-api-id.execute-api.your-region.amazonaws.com

# Optional Cognito configuration.
# The current frontend adapter will report Cognito as pending until its SDK
# integration is completed.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
